+def atomic_copy(source, destination):
+    destination.parent.mkdir(parents=True,exist_ok=True)
+    tmp=destination.with_name('.'+destination.name+'.partial')
+    try:
+        with source.open('rb') as src, tmp.open('wb') as dst:
+            shutil.copyfileobj(src,dst);dst.flush();os.fsync(dst.fileno())
+        os.replace(tmp,destination)
+    except BaseException:
+        tmp.unlink(missing_ok=True)
+        raise
+
+def import_baseline_bootstrap(archive, segments, latent_root, bootstrap_through=6):
+    """Validate and atomically publish a contiguous baseline bootstrap journal."""
+    if bootstrap_through!=6:raise ValueError('Only the validated C0-C6 bootstrap is supported')
+    provenance_path=archive/'provenance.json'
+    if not provenance_path.is_file():raise FileNotFoundError(provenance_path)
+    provenance=json.loads(provenance_path.read_text())
+    manifest=provenance.get('file_sha256')
+    if provenance.get('status')!='PASS' or provenance.get('bootstrap_through')!=bootstrap_through or not isinstance(manifest,dict):
+        raise RuntimeError('Bootstrap provenance is not a validated C0-C6 archive')
+    archive_files={path.name for path in archive.iterdir() if path.is_file() and path.name!='provenance.json'}
+    if archive_files!=set(manifest):raise RuntimeError('Bootstrap provenance hash manifest does not cover the archive exactly')
+    for name,digest in manifest.items():
+        source=archive/name
+        if not source.is_file() or not isinstance(digest,str) or file_sha256(source)!=digest:
+            raise RuntimeError(f'Bootstrap archive file missing or corrupt: {name}')
+    records=[]
+    for index in range(bootstrap_through+1):
+        record_name=f'chunk_{index:06d}.json'
+        segment_name=f'segment_{index:06d}.npy'
+        carry_name=f'carry_{index:06d}.pt'
+        record=json.loads((archive/record_name).read_text())
+        if (record.get('chunk_index')!=index or record.get('segment_file')!=segment_name
+                or record.get('carry_file')!=carry_name):
+            raise RuntimeError(f'Bootstrap record {index} does not reference its canonical segment/carry')
+        records.append((record_name,record))
+    latest_prefix=records[-1][1].get('next_prefix_file')
+    if latest_prefix!='previous_prefix_0.pt':raise RuntimeError('C6 bootstrap must publish previous_prefix_0.pt')
+    required={f'segment_{i:06d}.npy' for i in range(bootstrap_through+1)}
+    required|={f'carry_{i:06d}.pt' for i in range(bootstrap_through+1)}
+    required|={f'chunk_{i:06d}.json' for i in range(bootstrap_through+1)}
+    required|={latest_prefix,'model_ready.json'}
+    missing=required-set(manifest)
+    if missing:raise RuntimeError(f'Bootstrap manifest is missing required files: {sorted(missing)}')
+    if any((segments/name).exists() for name in required if not name.startswith('carry_')) or any((latent_root/f'carry_{i:06d}.pt').exists() for i in range(bootstrap_through+1)):
+        raise FileExistsError('Bootstrap destination already contains committed artifacts')
+    # Publish every prerequisite before any completion marker.  C6 is last so a
+    # crash can never make the reconstructed resume state appear committed early.
+    for index in range(bootstrap_through+1):atomic_copy(archive/f'segment_{index:06d}.npy',segments/f'segment_{index:06d}.npy')
+    for index in range(bootstrap_through+1):atomic_copy(archive/f'carry_{index:06d}.pt',latent_root/f'carry_{index:06d}.pt')
+    atomic_copy(archive/latest_prefix,segments/latest_prefix)
+    atomic_copy(archive/'model_ready.json',segments/'model_ready.json')
+    atomic_copy(provenance_path,segments/'bootstrap_provenance.json')
+    for record_name,_ in records[:-1]:atomic_copy(archive/record_name,segments/record_name)
+    atomic_copy(archive/records[-1][0],segments/records[-1][0])
+    return provenance
